---
import { Image } from 'astro:assets';
import Phone from './Phone.astro';
import { dict, localeInfo, type Locale } from '../i18n/locales';
import { shot, DEMO_GEOMETRY as G } from '../lib/shots';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = dict(locale);
const g = G[localeInfo(locale).shots];
const scale = G.cardWidth;
// Map the full-screen post image onto the grid card: x' = tx + s·x, y' = ty + s·y (origin top-left).
const style = [
  `--card-left:${g.cardLeft * 100}%`,
  `--card-top:${g.cardTop * 100}%`,
  `--card-w:${G.cardWidth * 100}%`,
  `--card-h:${g.cardHeight * 100}%`,
  `--s:${scale}`,
  `--tx:${g.cardLeft * 100}%`,
  `--ty:${(g.cardTop - scale * G.feedImageTop) * 100}%`,
  `--clip-top:${G.feedImageTop * 100}%`,
  `--clip-bottom:${G.feedImageBottomInset * 100}%`,
].join(';');
---

<figure class="demo" data-view="grid" style={style}>
  <Phone src={shot(locale, '1_grid')} alt="" eager>
    <div class="feed" aria-hidden="true">
      <Image src={shot(locale, '2_feed')} alt="" widths={[320, 480, 640, 960]} sizes="(max-width: 700px) 70vw, 340px" loading="eager" />
    </div>
    <button class="card-hit" type="button" tabindex="-1" aria-hidden="true"></button>
  </Phone>
  <figcaption>
    <button class="toggle" type="button" aria-pressed="false" data-to-full={t.hero.toggleToFull} data-to-grid={t.hero.toggleToGrid}>
      <svg class="i-grid" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="4" width="16" height="7" rx="2"></rect><rect x="4" y="13" width="16" height="7" rx="2"></rect></svg>
      <svg class="i-full" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="4" width="7" height="7" rx="1.5"></rect><rect x="13" y="4" width="7" height="7" rx="1.5"></rect><rect x="4" y="13" width="7" height="7" rx="1.5"></rect><rect x="13" y="13" width="7" height="7" rx="1.5"></rect></svg>
      <span class="label">{t.hero.toggleToFull}</span>
    </button>
    <span class="hint">{t.hero.demoCaption}</span>
  </figcaption>
</figure>

<style>
  .demo {
    margin: 0;
    display: grid;
    justify-items: center;
    gap: 18px;
  }
  .demo :global(.phone) {
    max-width: min(300px, 72vw);
  }

  .feed {
    position: absolute;
    inset: 0;
    transform-origin: 0 0;
    transform: translate(var(--tx), var(--ty)) scale(var(--s));
    clip-path: inset(var(--clip-top) 0 var(--clip-bottom) 0 round 2.4%);
    opacity: 0;
    /* closing: shrink first, then disappear into the card */
    transition:
      transform 0.42s cubic-bezier(0.3, 0, 0.2, 1),
      clip-path 0.42s cubic-bezier(0.3, 0, 0.2, 1),
      opacity 0.08s linear 0.4s;
    pointer-events: none;
  }
  .feed :global(img) {
    width: 100%;
    height: 100%;
  }
  .demo[data-view='full'] .feed {
    transform: none;
    clip-path: inset(0 0 0 0 round 0%);
    opacity: 1;
    /* opening: appear on the card, then grow */
    transition:
      transform 0.48s cubic-bezier(0.2, 0.8, 0.2, 1),
      clip-path 0.48s cubic-bezier(0.2, 0.8, 0.2, 1),
      opacity 0.06s linear;
  }

  .card-hit {
    position: absolute;
    left: var(--card-left);
    top: var(--card-top);
    width: var(--card-w);
    height: var(--card-h);
    border: 0;
    padding: 0;
    background: transparent;
    cursor: zoom-in;
    border-radius: 3%;
  }
  .demo[data-view='full'] .card-hit {
    inset: 0;
    width: auto;
    height: auto;
    cursor: zoom-out;
  }

  figcaption {
    display: grid;
    justify-items: center;
    gap: 10px;
    text-align: center;
  }
  .toggle {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 48px;
    padding: 0 20px;
    border-radius: 999px;
    border: 1.5px solid var(--wall-line);
    background: var(--wall-raised);
    color: var(--ink);
    font: inherit;
    font-size: 1rem;
    font-weight: 620;
    cursor: pointer;
  }
  .toggle:hover {
    border-color: var(--ink-muted);
  }
  .i-grid {
    display: none;
  }
  .demo[data-view='full'] .i-grid {
    display: block;
  }
  .demo[data-view='full'] .i-full {
    display: none;
  }
  .hint {
    font-size: var(--step--1);
    color: var(--ink-muted);
    max-width: 30ch;
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.demo').forEach((demo) => {
    const toggle = demo.querySelector<HTMLButtonElement>('.toggle')!;
    const label = toggle.querySelector('.label')!;
    const hit = demo.querySelector<HTMLButtonElement>('.card-hit')!;
    const set = (full: boolean) => {
      demo.dataset.view = full ? 'full' : 'grid';
      toggle.setAttribute('aria-pressed', String(full));
      label.textContent = full ? toggle.dataset.toGrid! : toggle.dataset.toFull!;
    };
    toggle.addEventListener('click', () => set(demo.dataset.view !== 'full'));
    hit.addEventListener('click', () => set(demo.dataset.view !== 'full'));
  });
</script>
