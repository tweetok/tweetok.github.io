---
import { appStoreLink, dict, localeInfo, pathFor, type Locale } from '../i18n/locales';

interface Props {
  locale: Locale;
  /** show the small notes under each button */
  notes?: boolean;
  /** hide the Android button (used on the Android page itself) */
  android?: boolean;
  /** where on the page the buttons sit, for analytics: hero, final, feature, guide */
  position?: string;
}

const { locale, notes = true, android = true, position = 'body' } = Astro.props;
const t = dict(locale);
// Page key without the locale prefix: '' -> home, '/ja/guides/apple-tv/' -> guides-apple-tv
const prefix = localeInfo(locale).prefix;
const path = Astro.url.pathname.replace(/^\/+|\/+$/g, '');
const pageKey = (prefix && path.startsWith(prefix) ? path.slice(prefix.length) : path).replace(/^\/+/, '').replace(/\//g, '-') || 'home';
const campaign = `web-${pageKey}-${locale}`;
---

<div class="store">
  <div class="store-item">
    <a
      class="btn btn-secondary"
      href={appStoreLink(campaign)}
      rel="noopener"
      data-track="app_store_click"
      data-position={position}
      data-campaign={campaign}
    >
      <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
        <path d="M16.37 12.6c-.02-2.2 1.8-3.26 1.88-3.31-1.03-1.5-2.62-1.7-3.18-1.73-1.35-.14-2.64.8-3.33.8-.68 0-1.74-.78-2.86-.76-1.47.02-2.83.86-3.59 2.17-1.53 2.65-.39 6.58 1.1 8.73.73 1.05 1.6 2.23 2.73 2.19 1.1-.04 1.51-.71 2.84-.71 1.32 0 1.7.71 2.86.69 1.18-.02 1.93-1.07 2.65-2.12.83-1.22 1.18-2.4 1.2-2.46-.03-.01-2.3-.88-2.3-3.49ZM14.2 6.13c.6-.73 1.01-1.75.9-2.76-.87.04-1.92.58-2.54 1.31-.56.64-1.05 1.67-.92 2.66.97.08 1.96-.49 2.56-1.21Z" />
      </svg>
      {t.cta.appStore}
    </a>
    {notes && <p class="store-note">{t.cta.appStoreNote}</p>}
  </div>
  {
    android && (
      <div class="store-item">
        <a class="btn btn-secondary" href={pathFor(locale, 'android-beta')}>
          <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
            <path d="M17.6 9.48 19.44 6.3a.38.38 0 1 0-.66-.38l-1.86 3.22A11.4 11.4 0 0 0 12 8.08c-1.77 0-3.43.4-4.92 1.06L5.22 5.92a.38.38 0 1 0-.66.38L6.4 9.48A10.8 10.8 0 0 0 1 18h22a10.8 10.8 0 0 0-5.4-8.52ZM7 15.25a1.25 1.25 0 1 1 0-2.5 1.25 1.25 0 0 1 0 2.5Zm10 0a1.25 1.25 0 1 1 0-2.5 1.25 1.25 0 0 1 0 2.5Z" />
          </svg>
          {t.cta.android}
        </a>
        {notes && <p class="store-note">{t.cta.androidNote}</p>}
      </div>
    )
  }
</div>

<style>
  .store {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 20px;
    align-items: flex-start;
  }
  .store-item {
    display: grid;
    justify-items: center;
    gap: 8px;
  }
  .store-note {
    font-size: var(--step--1);
    color: var(--ink-muted);
    text-align: center;
  }
</style>
