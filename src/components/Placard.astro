---
// A museum wall label: what the feature is, where it runs, and whether it's free.
interface Props {
  title: string;
  where: string;
  tiers: string[];
  more?: { href: string; label: string };
}

const { title, where, tiers, more } = Astro.props;
---

<div class="placard">
  <h3>{title}</h3>
  <p class="where">{where}</p>
  <p class="body"><slot /></p>
  <div class="foot">
    <ul class="tiers">
      {tiers.map((tier) => <li>{tier}</li>)}
    </ul>
    {more && <a class="more" href={more.href}>{more.label}</a>}
  </div>
</div>

<style>
  .placard {
    background: var(--paper);
    color: var(--paper-ink);
    padding: 26px 28px 22px;
    border-radius: 3px;
    box-shadow:
      0 1px 0 rgb(255 255 255 / 0.5) inset,
      0 14px 30px -18px rgb(0 0 0 / 0.8);
    max-width: 400px;
    display: grid;
    gap: 6px;
  }
  h3 {
    font-size: var(--step-1);
    letter-spacing: -0.015em;
  }
  .where {
    font-size: var(--step--1);
    font-style: italic;
    color: var(--paper-muted);
  }
  .body {
    margin-top: 10px;
    font-size: 1.0625rem;
    line-height: 1.55;
  }
  .foot {
    margin-top: 16px;
    padding-top: 12px;
    border-top: 1px solid rgb(43 34 39 / 0.18);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }
  .tiers {
    display: flex;
    gap: 6px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .tiers li {
    font-size: 0.8125rem;
    font-weight: 650;
    padding: 2px 9px;
    border-radius: 999px;
    border: 1px solid rgb(43 34 39 / 0.35);
  }
  .more {
    font-size: 0.9375rem;
    font-weight: 620;
    color: var(--paper-ink);
  }
  .more:focus-visible {
    outline-color: var(--paper-ink);
  }
</style>
