---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  eager?: boolean;
  class?: string;
}

const { src, alt, eager = false, class: className } = Astro.props;
---

<div class:list={['phone', className]}>
  <div class="screen">
    <Image
      src={src}
      alt={alt}
      widths={[320, 480, 640, 960]}
      sizes="(max-width: 700px) 70vw, 340px"
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : 'auto'}
    />
    <slot />
  </div>
</div>

<style>
  .phone {
    --bezel: clamp(7px, 2.4cqw, 11px);
    container-type: inline-size;
    width: 100%;
    max-width: 340px;
    padding: var(--bezel);
    border-radius: 15.5% / 7.2%;
    background: #0a0809;
    box-shadow:
      0 0 0 1.5px #4a3d44,
      0 40px 80px -30px rgb(0 0 0 / 0.75);
  }
  .screen {
    position: relative;
    overflow: hidden;
    border-radius: 13% / 6%;
    aspect-ratio: 1206 / 2622;
    background: #000;
  }
  .screen :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
