---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { LOCALES, SITE, APP_STORE_ID, localeInfo, pathFor, type Locale } from '../i18n/locales';

interface Props {
  locale: Locale;
  /** page slug without slashes, '' for home */
  slug: string;
  title: string;
  description: string;
  jsonLd?: object[];
  noindex?: boolean;
  /** false for pages that exist only once (privacy, support): no hreflang, language links go to each home page */
  localized?: boolean;
}

const { locale, slug, title, description, jsonLd = [], noindex = false, localized = true } = Astro.props;
const info = localeInfo(locale);
const canonical = new URL(pathFor(locale, slug), SITE).href;
const ogImage = new URL(info.og, SITE).href;
---

<!doctype html>
<html lang={info.tag}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    {
      !noindex && localized &&
        LOCALES.map((l) => (
          <link rel="alternate" hreflang={l.tag} href={new URL(pathFor(l.code, slug), SITE).href} />
        ))
    }
    {!noindex && localized && <link rel="alternate" hreflang="x-default" href={new URL(pathFor('en', slug), SITE).href} />}

    <meta name="theme-color" content="#1d151a" />
    <meta name="apple-itunes-app" content={`app-id=${APP_STORE_ID}`} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="TweeTok" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="675" />
    <meta property="og:locale" content={info.ogLocale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
  </head>
  <body>
    <Header locale={locale} slug={slug} localized={localized} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} slug={slug} localized={localized} />
  </body>
</html>
