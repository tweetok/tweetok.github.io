---
import Base from '../layouts/Base.astro';
import { dict, pathFor } from '../i18n/locales';

const t = dict('en');
---

<Base locale="en" slug="" title={`${t.notFound.title} | TweeTok`} description={t.notFound.body} noindex>
  <section>
    <div class="wrap" style="display:grid;gap:20px;justify-items:start">
      <h1 style="font-size:var(--step-4)">{t.notFound.title}</h1>
      <p class="muted">{t.notFound.body}</p>
      <a class="btn btn-secondary" href={pathFor('en')}>{t.notFound.back}</a>
    </div>
  </section>
</Base>
