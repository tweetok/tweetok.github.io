---
import { Image } from 'astro:assets';
import Base from '../../../layouts/Base.astro';
import Phone from '../../../components/Phone.astro';
import StoreButtons from '../../../components/StoreButtons.astro';
import { LOCALES, dict, localeInfo, pathFor, SITE, type Locale } from '../../../i18n/locales';
import { GUIDE_SLUGS, GUIDES_DATE, guide, guides, guideImage, fillGuide, type Guide } from '../../../content/guides';

export function getStaticPaths() {
  return LOCALES.flatMap((l) =>
    GUIDE_SLUGS.map((slug) => ({
      params: { lang: l.prefix || undefined, slug },
      props: { locale: l.code, slug },
    })),
  );
}

const { locale, slug } = Astro.props as { locale: Locale; slug: Guide['slug'] };
const t = dict(locale);
const g = guides(locale);
const item = guide(locale, slug);
const img = guideImage(locale, item.image);
const pageSlug = `guides/${slug}`;
const url = new URL(pathFor(locale, pageSlug), SITE).href;
const others = g.guides.filter((o) => o.slug !== slug);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: item.h1,
    description: item.description,
    inLanguage: localeInfo(locale).tag,
    mainEntityOfPage: url,
    datePublished: GUIDES_DATE,
    dateModified: GUIDES_DATE,
    image: new URL(localeInfo(locale).og, SITE).href,
    author: { '@type': 'Organization', name: 'TweeTok', url: new URL(pathFor(locale), SITE).href },
    publisher: { '@type': 'Organization', name: 'TweeTok', logo: { '@type': 'ImageObject', url: new URL('/apple-touch-icon.png', SITE).href } },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: t.nav.home, item: new URL(pathFor(locale), SITE).href },
      { '@type': 'ListItem', position: 2, name: g.indexH1, item: new URL(pathFor(locale, 'guides'), SITE).href },
      { '@type': 'ListItem', position: 3, name: item.h1, item: url },
    ],
  },
];
---

<Base locale={locale} slug={pageSlug} title={item.title} description={item.description} jsonLd={jsonLd}>
  <article>
    <header class="head">
      <div class="wrap">
        <nav class="crumbs" aria-label={t.nav.guides}>
          <a href={pathFor(locale)}>TweeTok</a>
          <span aria-hidden="true">/</span>
          <a href={pathFor(locale, 'guides')}>{g.indexH1}</a>
        </nav>
        <h1>{item.h1}</h1>
        <p class="lead measure">{item.lead}</p>
        <p class="updated">{g.updated}</p>
      </div>
    </header>

    <div class:list={['wrap body', { wide: img.wide }]}>
      <figure class="visual">
        {
          img.wide ? (
            <div class="tv">
              <Image src={img.src} alt={item.imageAlt} widths={[640, 960, 1280, 1920]} sizes="(max-width: 1240px) 92vw, 1100px" loading="eager" fetchpriority="high" />
            </div>
          ) : (
            <Phone src={img.src} alt={item.imageAlt} eager />
          )
        }
      </figure>

      <div class="prose">
        {
          item.sections.map((s) => (
            <section>
              <h2>{s.h2}</h2>
              {s.paragraphs.map((p) => <p>{fillGuide(p)}</p>)}
              {s.steps && (
                <ol>
                  {s.steps.map((step) => <li>{fillGuide(step)}</li>)}
                </ol>
              )}
            </section>
          ))
        }

        <aside class="cta">
          <h2>{g.ctaTitle}</h2>
          <p>{g.ctaBody}</p>
          <StoreButtons locale={locale} notes={false} />
        </aside>
      </div>
    </div>
  </article>

  <nav class="related" aria-labelledby="related-title">
    <div class="wrap">
      <h2 id="related-title">{g.relatedTitle}</h2>
      <ul>
        {others.map((o) => <li><a href={pathFor(locale, `guides/${o.slug}`)}>{o.h1}</a></li>)}
      </ul>
    </div>
  </nav>
</Base>

<style>
  .head {
    padding-block: clamp(40px, 6vw, 80px) clamp(24px, 4vw, 40px);
  }
  .head .wrap {
    display: grid;
    gap: 18px;
    justify-items: start;
  }
  .crumbs {
    display: flex;
    gap: 8px;
    font-size: var(--step--1);
    color: var(--ink-muted);
  }
  .crumbs a {
    color: var(--ink-muted);
    text-decoration: none;
  }
  .crumbs a:hover {
    color: var(--ink);
  }
  h1 {
    font-size: var(--step-3);
    max-width: 22em;
  }
  .lead {
    font-size: 1.25rem;
    color: var(--ink-muted);
  }
  .updated {
    font-size: var(--step--1);
    color: var(--ink-muted);
  }

  .body {
    display: grid;
    grid-template-columns: 300px minmax(0, 1fr);
    gap: clamp(40px, 7vw, 100px);
    align-items: start;
    padding-bottom: clamp(56px, 8vw, 96px);
  }
  .body.wide {
    grid-template-columns: minmax(0, 1fr);
    gap: 48px;
  }
  .visual {
    margin: 0;
    position: sticky;
    top: 100px;
    display: grid;
    justify-items: center;
  }
  .body.wide .visual {
    position: static;
  }
  .tv {
    width: 100%;
    padding: 10px;
    background: #0a0809;
    border-radius: 14px;
    box-shadow:
      0 0 0 1.5px #4a3d44,
      0 40px 80px -30px rgb(0 0 0 / 0.75);
  }
  .tv :global(img) {
    width: 100%;
    border-radius: 6px;
  }

  .prose {
    max-width: 38em;
    font-size: 1.0625rem;
  }
  :lang(ja) .prose,
  :lang(ko) .prose,
  :lang(zh-Hant) .prose,
  :lang(zh-Hans) .prose {
    max-width: 34em;
  }
  .prose section {
    padding-block: 0;
  }
  .prose section + section {
    margin-top: 40px;
  }
  .prose h2 {
    font-size: var(--step-1);
    letter-spacing: -0.015em;
    margin-bottom: 14px;
  }
  .prose p + p {
    margin-top: 12px;
  }
  .prose p {
    color: var(--ink);
  }
  .prose ol {
    margin: 16px 0 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
    display: grid;
    gap: 12px;
  }
  .prose ol li {
    counter-increment: step;
    position: relative;
    padding-left: 44px;
    min-height: 30px;
  }
  .prose ol li::before {
    content: counter(step);
    position: absolute;
    left: 0;
    top: 0;
    width: 30px;
    height: 30px;
    display: grid;
    place-items: center;
    border-radius: 999px;
    background: var(--rose);
    color: var(--on-rose);
    font-size: 0.9375rem;
    font-weight: 760;
  }

  .cta {
    margin-top: 56px;
    padding: 28px;
    background: var(--paper);
    color: var(--paper-ink);
    border-radius: 3px;
    display: grid;
    gap: 12px;
  }
  .cta h2 {
    margin: 0;
  }
  .cta p {
    color: var(--paper-ink);
  }
  .cta :global(.store) {
    margin-top: 8px;
  }
  .cta :global(.btn-secondary) {
    color: var(--paper-ink);
    border-color: rgb(43 34 39 / 0.3);
  }
  .cta :global(.btn-secondary:hover) {
    border-color: var(--paper-ink);
  }
  .cta :global(.store-note) {
    color: var(--paper-muted);
  }

  .related {
    border-top: 1px solid var(--wall-line);
    padding-block: 48px 56px;
  }
  .related h2 {
    font-size: var(--step-1);
    margin-bottom: 18px;
  }
  .related ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 12px;
  }
  .related a {
    font-weight: 560;
  }

  @media (max-width: 860px) {
    .body {
      grid-template-columns: minmax(0, 1fr);
    }
    .visual {
      position: static;
    }
    .visual :global(.phone) {
      max-width: 240px;
    }
  }
</style>
