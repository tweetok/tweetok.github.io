---
import FeaturePage from '../../components/FeaturePage.astro';
import PhoneDemo from '../../components/PhoneDemo.astro';
import { localePaths, type Locale } from '../../i18n/locales';

export function getStaticPaths() {
  return localePaths();
}

const { locale } = Astro.props as { locale: Locale };
---

<FeaturePage locale={locale} slug="grid-view">
  <PhoneDemo locale={locale} />
</FeaturePage>
